# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/blogDB

# Comma-separated admin emails who have access to the Admin Panel
ADMIN_EMAILS=admin@blog.com,bhuvanaragavan28@gmail.com

# Allowed frontend origin (URL where React app runs)
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Firebase Project ID (Matches your Firebase Console Project ID)
FIREBASE_PROJECT_ID=
